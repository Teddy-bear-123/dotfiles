####################################
# https://github.com/husseinhareb/dotfiles-i3-/blob/main/i3/config
#
#
#####################################


# Set Super as mod key 

set $mod Mod4
set $mod1 Mod1

# Font for window tiles, shoudnt be used for anything else 
font pango:Hack Nerd Font 8

exec  clipse -listen        

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3 

# external locker as X screen saver
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# manage wifi
exec --no-startup-id nm-applet


# manage sound

include ~/.config/i3/DunstSound.conf

# Let mod + mouse move floating windows 
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar or left-clicking anywhere into the window while holding mod. 
tiling_drag modifier titlebar



# Keybindings
bindsym $mod+Return exec x-terminal-emulator
bindsym $mod+space exec rofi -show drun
bindsym $mod+Shift+q kill
bindsym $mod+$mod1+q [con_id="__focused__"] exec --no-startup-id kill -9 $(xdotool getwindowfocus getwindowpid)
# bindsym $mod+Mod1+q exec --no-startup-id i3-msg \[class=\"$(xdotool getwindowfocus getwindowclassname)\"\] kill
bindsym $mod+w exec XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi
bindsym $mod+s exec --no-startup-id alacritty -e "$SHELL" -c "i3-msg 'floating enable' && spt" 
bindsym $mod+Shift+s exec --no-startup-id alacritty -e "$SHELL" -c "i3-msg 'floating enable' && spotify_player"
bindsym $mod+comma exec --no-startup-id alacritty -e "$SHELL" -c "i3-msg 'floating enable' && clipse" 
bindsym Print exec gnome-screenshot -c -f ~/Pictures/Screenshots/$(date '+%Y-%m-%d_%H-%M-%S').png  
bindsym Ctrl+Shift+5 exec ~/.config/i3/screenshot.sh 
bindsym $mod+Shift+Return exec x-www-browser


# bindsym Control+Mod1+l exec /home/cv-rishi/.config/i3/lock.sh

exec "xautolock -detectsleep -time 3 -locker \"/home/cv-rishi/.config/i3/lock.sh\""


# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the arrow keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the arrow keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle

# split in horizontal orientation
# bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# change focus between tiling / floating windows / tabbed split 
bindsym $mod+t layout toggle tabbed splith splitv

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+d focus child

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Tab workspace next


# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# exit i3 (logs you out of your X session)
bindsym $mod+Shift+p exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. What would you like to do?' -B 'Yes, exit i3' 'i3-msg exit' -B 'Shut Down' 'shutdown'"



# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

exec feh --bg-fill /usr/share/backgrounds/back1-fix.jpg
exec polybar -q
default_border none

exec --no-startup-id /usr/local/bin/picom -b --config ~/.config/picom/config --log-file=/home/cv-rishi/.config/picom/picom.log

gaps inner 5
gaps outer 0

# Increase inner gaps
bindsym $mod+Shift+plus gaps inner current plus 1

# Decrease inner gaps
bindsym $mod+Shift+minus gaps inner current minus 1

# Increase outer gaps
bindsym $mod+Control+plus gaps outer current plus 1

# Decrease outer gaps
bindsym $mod+Control+minus gaps outer current minus 1


exec --no-startup-id chmod +x ~/.local/share/AppImage/ZenBrowser.AppImage

# Prevent Zathura from stealing focus for LaTeX
for_window [class="Zathura"] no_focus
